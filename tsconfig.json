{
  "compilerOptions": {
    // "baseUrl": "./src",
    // "allowSyntheticDefaultImports": true,
    // "module": "esnext",
    // "moduleResolution": "node",
    // "target": "es2020",
    // "sourceMap": true,
    // "jsx": "react",
    // "allowJs": true,
    // "strict": false,
    // "noUnusedLocals": true
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "outDir": "./dist/",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "esnext",
  },
  "include": ["src"],
  "exclude": ["node_modules"],
  "ts-node": {
    "files": true,
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}