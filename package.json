    "@unleash/proxy-client-react": "^5.0.1",
    "axios": "^1.11.0",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^6.7.1",
    "cypress": "^12.17.4",
    "cypress-multi-reporters": "^1.6.2",
